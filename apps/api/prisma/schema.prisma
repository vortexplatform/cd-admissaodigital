generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CANDIDATO
  RH
  ADMIN
}

model User {
  id        Int              @id @default(autoincrement())
  cpf       String?          @unique
  nome      String?
  email     String?          @unique
  telefone  String?          @unique
  role         Role             @default(CANDIDATO)
  passwordHash String?          @map("password_hash")
  createdAt    DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  candidato Candidato?
  empresas  EmpresaUsuario[]

  requisicoesCriadas           RequisicaoVaga[]       @relation("RequisicaoCriadaPor")
  requisicoesAprovadas         RequisicaoVaga[]       @relation("RequisicaoAprovadaPor")
  candidaturasCriadas          Candidatura[]          @relation("CandidaturaCriadaPor")
  admissoesGeradas             Candidatura[]          @relation("CandidaturaAdmissaoGeradaPor")
  documentosRevisados          DocumentoAdmissao[]    @relation("DocumentoRevisadoPor")
  envelopesAssinatura          EnvelopeAssinatura[]
  envelopesGerados             EnvelopeAssinatura[]   @relation("EnvelopeGeradoPor")
  certificadosA1Criados        EmpresaCertificadoA1[] @relation("CertificadoA1CriadoPor")
  biometriaSolicitacoesCriadas BiometriaSolicitacao[] @relation("BiometriaSolicitadaPor")
  refreshTokens                 RefreshToken[]

  @@map("users")
}

model Candidato {
  id                            Int                    @id @default(autoincrement())
  userId                        Int?                   @unique
  cpf                           String                 @unique
  dataNascimento                DateTime               @db.Date
  nome                          String?
  email                         String?
  telefone                      String?
  genero                        String?
  situacao                      String                 @default("ATIVO_PROCESSO")
  justificativaReprovacao       String?                @map("justificativa_reprovacao")
  possuiFilhos                  Boolean                @default(false) @map("possui_filhos")
  biometriaStatus               BiometriaStatus        @default(NAO_CADASTRADA) @map("biometria_status")
  biometriaCadastradaEm         DateTime?              @map("biometria_cadastrada_em")
  biometriaIdentificadorExterno String?                @map("biometria_identificador_externo")

  // Admissão
  tipoAdmissao                  String?                @map("tipo_admissao")

  // Dados pessoais adicionais
  estadoCivil                   String?                @map("estado_civil")
  grauInstrucao                 String?                @map("grau_instrucao")
  pis                           String?
  raccor                        Int?

  // Naturalidade
  nacionalidade                 Int?
  paisNascimento                String?                @map("pais_nascimento")
  estadoNascimento              String?                @map("estado_nascimento")
  cidadeNascimentoCod           Int?                   @map("cidade_nascimento_cod")
  cidadeNascimentoNome          String?                @map("cidade_nascimento_nome")

  // Endereço
  pais                          String?
  cep                           String?
  estadoEndereco                String?                @map("estado_endereco")
  cidadeCod                     Int?                   @map("cidade_cod")
  cidadeNome                    String?                @map("cidade_nome")
  bairroCod                     Int?                   @map("bairro_cod")
  bairroNome                    String?                @map("bairro_nome")
  tipoLogradouro                String?                @map("tipo_logradouro")
  endereco                      String?
  numero                        String?
  complemento                   String?

  // Contatos (telefone principal é o campo legado `telefone`)
  ddiTelefone                   String?                @map("ddi_telefone")
  dddTelefone                   String?                @map("ddd_telefone")
  numeroTelefone                String?                @map("numero_telefone")
  ddiTelefone2                  String?                @map("ddi_telefone2")
  dddTelefone2                  String?                @map("ddd_telefone2")
  numeroTelefone2               String?                @map("numero_telefone2")

  // RG
  numeroRg                      String?                @map("numero_rg")
  orgaoEmissorRg                String?                @map("orgao_emissor_rg")
  dataExpedicaoRg               DateTime?              @db.Date @map("data_expedicao_rg")

  // Título de eleitor
  numeroTituloEleitor           String?                @map("numero_titulo_eleitor")
  zonaTituloEleitor             String?                @map("zona_titulo_eleitor")
  secaoTituloEleitor            String?                @map("secao_titulo_eleitor")

  // Reservista
  numeroCertReservista          String?                @map("numero_cert_reservista")

  // Certidão civil
  tipoCertidaoCivil             String?                @map("tipo_certidao_civil")
  dataEmissaoCertidaoCivil      DateTime?              @db.Date @map("data_emissao_certidao_civil")
  matriculaCertidaoCivil        String?                @map("matricula_certidao_civil")
  termoMatriculaCertidao        String?                @map("termo_matricula_certidao")
  livroCertidaoCivil            String?                @map("livro_certidao_civil")
  folhaCertidaoCivil            String?                @map("folha_certidao_civil")
  estadoCertidaoCivil           String?                @map("estado_certidao_civil")
  cidadeCertidaoCivilCod        Int?                   @map("cidade_certidao_civil_cod")
  cidadeCertidaoCivilNome       String?                @map("cidade_certidao_civil_nome")

  // Uniforme
  tamanhoCamisa                 String?                @map("tamanho_camisa")
  tamanhoCalca                  String?                @map("tamanho_calca")
  tamanhoCalcado                String?                @map("tamanho_calcado")
  cidadeVagaId                  Int                    @map("cidade_vaga_id")

  // Responsável legal (obrigatório para menores 16-17 anos)
  responsavelNome               String?                @map("responsavel_nome")
  responsavelCpf                String?                @map("responsavel_cpf")
  responsavelEmail              String?                @map("responsavel_email")
  responsavelTelefone           String?                @map("responsavel_telefone")

  user                          User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  cidadeVaga                    CidadeVaga             @relation(fields: [cidadeVagaId], references: [id], onDelete: Restrict)
  candidaturas                  Candidatura[]
  biometriaSolicitacoes         BiometriaSolicitacao[]
  biometriaTemplates            BiometriaTemplate[]
  aceitesRegulamento            AceiteRegulamento[]
  dependentes                   CandidatoDependente[]
  valeTransportes               CandidatoValeTransporte[]
  etapas                        CandidatoEtapa[]

  @@map("candidato")
}

model CidadeVaga {
  id         Int         @id @default(autoincrement())
  nome       String      @unique
  candidatos Candidato[]

  @@map("cidade_vaga")
}

model CandidatoDependente {
  id                         Int      @id @default(autoincrement())
  candidatoId                Int      @map("candidato_id")
  nome                       String
  codigoGrauParentesco       String   @map("codigo_grau_parentesco")
  descricaoGrauParentesco    String   @map("descricao_grau_parentesco")
  codigoTipoEsocial          Int      @map("codigo_tipo_esocial")
  descricaoTipoEsocial       String   @map("descricao_tipo_esocial")
  sexo                       String
  dependenteIr               Boolean  @default(false) @map("dependente_ir")
  dataNascimento             DateTime? @db.Date @map("data_nascimento")
  cpf                        String
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  candidato Candidato @relation(fields: [candidatoId], references: [id], onDelete: Cascade)

  @@index([candidatoId])
  @@map("candidato_dependentes")
}

model CandidatoValeTransporte {
  id                  Int      @id @default(autoincrement())
  candidatoId         Int      @map("candidato_id")
  tipoTransporte      String   @map("tipo_transporte")
  tipoTrajeto         String   @map("tipo_trajeto")
  transporteUsado     String   @map("transporte_usado")
   tarifaUnitaria      Decimal  @db.Decimal(10, 2) @map("tarifa_unitaria")
   valesPorDia         Int      @default(1) @map("vales_por_dia")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  candidato Candidato @relation(fields: [candidatoId], references: [id], onDelete: Cascade)

  @@index([candidatoId])
  @@map("candidato_vale_transportes")
}

model CandidatoEtapa {
  id             Int       @id @default(autoincrement())
  candidatoId    Int       @map("candidato_id")
  codigoEtapa    Int       @map("codigo_etapa")
  descricaoEtapa String    @map("descricao_etapa")
  data           DateTime? @db.Date
  sequencia      Int       @default(0)
  observacao     String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  candidato Candidato @relation(fields: [candidatoId], references: [id], onDelete: Cascade)

  @@unique([candidatoId, codigoEtapa])
  @@index([candidatoId])
  @@map("candidato_etapas")
}

model AceiteRegulamento {
  id                    Int        @id @default(autoincrement())
  candidatoId           Int        @map("candidato_id")
  documentoAssinaturaId Int?       @map("documento_assinatura_id")
  versaoRegulamento     String     @map("versao_regulamento")
  hashRegulamento       String     @map("hash_regulamento")
  aceitoEm              DateTime   @map("aceito_em")
  ip                    String?
  userAgent             String?    @map("user_agent")
  codigoVerificacao     String     @unique @map("codigo_verificacao")
  createdAt             DateTime   @default(now()) @map("created_at")

  candidato Candidato @relation(fields: [candidatoId], references: [id], onDelete: Cascade)

  @@index([candidatoId])
  @@map("aceite_regulamento")
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique @map("token_hash")
  userId    Int       @map("user_id")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_token")
}

model CodeOtp {
  id         String   @id @default(cuid())
  identifier String
  code       String
  expiresAt  DateTime
  used       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([identifier])
  @@map("codeotp")
}

model IntegrationClient {
  id               Int       @id @default(autoincrement())
  nome             String
  clientId         String    @unique @map("client_id")
  clientSecretHash String    @map("client_secret_hash")
  scopes           String[]  @default([])
  ativo            Boolean   @default(true)
  lastUsedAt       DateTime? @map("last_used_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([ativo])
  @@map("integration_client")
}

model Empresa {
  id                  Int                    @id @default(autoincrement())
  nome                String
  codigoEmpresaSenior String                 @unique @map("codigo_empresa_senior")
  requisicoes         RequisicaoVaga[]
  usuarios            EmpresaUsuario[]
  documentosTemplate  DocumentoTemplate[]
  certificadosA1      EmpresaCertificadoA1[]

  @@map("empresa")
}

model EmpresaCertificadoA1 {
  id                 Int      @id @default(autoincrement())
  empresaId          Int      @map("empresa_id")
  nomeArquivo        String   @map("nome_arquivo")
  pfxCriptografado   String   @map("pfx_criptografado")
  senhaCriptografada String   @map("senha_criptografada")
  subject            String
  issuer             String
  serialNumber       String   @map("serial_number")
  validoDe           DateTime @map("valido_de")
  validoAte          DateTime @map("valido_ate")
  thumbprint         String
  ativo              Boolean  @default(true)
  criadoPorUserId    Int?     @map("criado_por_user_id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  empresa              Empresa               @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  criadoPor            User?                 @relation("CertificadoA1CriadoPor", fields: [criadoPorUserId], references: [id], onDelete: SetNull)
  documentosAssinatura DocumentoAssinatura[]

  @@index([empresaId, ativo])
  @@map("empresa_certificado_a1")
}

model EmpresaUsuario {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  empresaId Int      @map("empresa_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([userId, empresaId])
  @@index([empresaId])
  @@map("empresa_usuario")
}

enum StatusRequisicaoVaga {
  RASCUNHO
  ABERTA
  AGUARDANDO_CANDIDATO
  EM_ADMISSAO
  AGUARDANDO_DOCUMENTOS
  AGUARDANDO_ASSINATURA
  AGUARDANDO_RH
  PENDENTE_CORRECAO
  APROVADA
  INTEGRANDO_SENIOR
  INTEGRADA_SENIOR
  CANCELADA
  REPROVADA
  ERRO_INTEGRACAO
}

enum TipoRequisicaoVaga {
  NOVA_VAGA
  SUBSTITUICAO
  AUMENTO_QUADRO
  TEMPORARIA
  OUTRO
}

enum StatusCandidatura {
  INSCRITO
  EM_ANALISE
  ENTREVISTA
  APROVADO
  EFETIVADO
  REPROVADO
  DESISTIU
  CANCELADO
}

model RequisicaoVaga {
  id Int @id @default(autoincrement())

  candidaturas Candidatura[]

  criadoPorUserId Int?
  criadoPor       User? @relation("RequisicaoCriadaPor", fields: [criadoPorUserId], references: [id], onDelete: SetNull)

  aprovadoPorUserId Int?
  aprovadoPor       User? @relation("RequisicaoAprovadaPor", fields: [aprovadoPorUserId], references: [id], onDelete: SetNull)

  tipo   TipoRequisicaoVaga   @default(NOVA_VAGA)
  status StatusRequisicaoVaga @default(RASCUNHO)

  quantidadeVagas Int @default(1)

  empresaId         Int?     @map("empresa")
  empresa           Empresa? @relation(fields: [empresaId], references: [id], onDelete: SetNull)
  filial            Int?
  filialNome        String?  @map("filial_nome")
  postoTrabalho     String?  @map("posto_trabalho")
  postoTrabalhoNome String?  @map("posto_trabalho_nome")
  cargo             String?
  cargoNome         String?  @map("cargo_nome")
  centroCusto       String?
  ccustoNome        String?  @map("ccusto_nome")
  escala            String?
  descricaoEscala   String?  @map("descricao_escala")
  sindicato         String?
  salario           Decimal? @db.Decimal(12, 2)

  dataPrevistaAdmissao DateTime? @db.Date

  prazoContratoDias Int? @map("prazo_contrato_dias")
  prorrogacaoDias   Int? @map("prorrogacao_dias")
  estcar            Int  @default(0)

  motivoAbertura String?
  observacao     String?

  codigoRequisicaoSenior  String?
  codigoCandidatoSenior   String?
  codigoColaboradorSenior String?

  aprovadoEm        DateTime?
  integradoSeniorEm DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([empresaId, filial], map: "requisicao_vaga_empresa_filial_idx")
  @@map("requisicao_vaga")
}

model Candidatura {
  id           Int               @id @default(autoincrement())
  requisicaoId Int               @map("requisicao_id")
  candidatoId  Int               @map("candidato_id")
  status                StatusCandidatura @default(INSCRITO)
  admissao              DateTime?         @db.Date
  dataAdmissaoPrevista  DateTime?         @map("data_admissao_prevista") @db.Date
  matricula             String?           @map("matricula")

  criadoPorUserId           Int?      @map("criado_por_user_id")
  admissaoGeradaPorUserId   Int?      @map("admissao_gerada_por_user_id")

  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  requisicao              RequisicaoVaga         @relation(fields: [requisicaoId], references: [id], onDelete: Cascade)
  candidato               Candidato              @relation(fields: [candidatoId], references: [id], onDelete: Cascade)
  criadoPor               User?                  @relation("CandidaturaCriadaPor", fields: [criadoPorUserId], references: [id], onDelete: SetNull)
  admissaoGeradaPor       User?                  @relation("CandidaturaAdmissaoGeradaPor", fields: [admissaoGeradaPorUserId], references: [id], onDelete: SetNull)
  documentos              DocumentoAdmissao[]
  envelopesAssinatura     EnvelopeAssinatura[]
  biometriaSolicitacoes   BiometriaSolicitacao[]

  @@unique([requisicaoId, candidatoId])
  @@index([candidatoId])
  @@index([status])
  @@map("candidatura")
}

enum SetorAssinatura {
  ADM_PESSOAL
  SESMT
}

enum StatusEnvelopeAssinatura {
  RASCUNHO
  AGUARDANDO_OTP
  OTP_VALIDADO
  CONCLUIDO
  CANCELADO
}

enum StatusDocumentoAssinatura {
  PENDENTE
  ASSINADO
  CANCELADO
}

enum MetodoAssinatura {
  OTP
  BIOMETRIA
}

enum TipoSignatario {
  CANDIDATO
  RESPONSAVEL
}

enum TipoEventoAssinatura {
  ENVELOPE_CRIADO
  OTP_ENVIADO
  OTP_VALIDADO
  DOCUMENTO_VISUALIZADO
  DOCUMENTO_ASSINADO
  DOCUMENTO_ASSINADO_BIOMETRIA
  DOCUMENTO_CERTIFICADO_EMPRESA
  ENVELOPE_CONCLUIDO
}

enum BiometriaStatus {
  NAO_CADASTRADA
  CADASTRADA
  ERRO
}

enum TipoBiometriaSolicitacao {
  CADASTRO
  VERIFICACAO_ASSINATURA
}

enum StatusBiometriaSolicitacao {
  PENDENTE
  EM_ATENDIMENTO
  CONCLUIDA
  REPROVADA
  FALHOU
  EXPIRADA
  CANCELADA
}

enum ResultadoBiometriaSolicitacao {
  APROVADO
  REPROVADO
  FALHOU
}

model EnvelopeAssinatura {
  id              Int                      @id @default(autoincrement())
  candidaturaId   Int                      @map("candidatura_id")
  userId          Int                      @map("user_id")
  geradoPorUserId Int?                     @map("gerado_por_user_id")
  setor           SetorAssinatura
  tipoSignatario  TipoSignatario           @default(CANDIDATO) @map("tipo_signatario")
  status          StatusEnvelopeAssinatura @default(RASCUNHO)
  otpIdentifier   String?                  @map("otp_identifier")
  otpValidadoEm   DateTime?                @map("otp_validado_em")
  sessionToken    String?                  @unique @map("session_token")
  sessionExpiraEm DateTime?                @map("session_expira_em")
  accessToken     String?                  @unique @map("access_token")
  concluidoEm     DateTime?                @map("concluido_em")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")

  candidatura           Candidatura            @relation(fields: [candidaturaId], references: [id], onDelete: Cascade)
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  geradoPor             User?                  @relation("EnvelopeGeradoPor", fields: [geradoPorUserId], references: [id], onDelete: SetNull)
  documentos            DocumentoAssinatura[]
  eventos               EventoAssinatura[]
  biometriaSolicitacoes BiometriaSolicitacao[]

  @@unique([candidaturaId, setor, tipoSignatario])
  @@index([userId])
  @@index([status])
  @@map("envelope_assinatura")
}

model DocumentoAssinatura {
  id                     Int                       @id @default(autoincrement())
  envelopeId             Int                       @map("envelope_id")
  codigo                 String
  nome                   String
  descricao              String?
  ordem                  Int                       @default(0)
  conteudo               String?
  conteudoStoragePath    String?                   @map("conteudo_storage_path")
  hashOriginal           String                    @map("hash_original")
  hashAssinado           String?                   @map("hash_assinado")
  status                 StatusDocumentoAssinatura @default(PENDENTE)
  visualizadoEm          DateTime?                 @map("visualizado_em")
  assinadoEm             DateTime?                 @map("assinado_em")
  assinaturaNome         String?                   @map("assinatura_nome")
  assinaturaCpf          String?                   @map("assinatura_cpf")
  assinaturaIp           String?                   @map("assinatura_ip")
  assinaturaUserAgent    String?                   @map("assinatura_user_agent")
  assinaturaEmail        String?                   @map("assinatura_email")
  assinaturaTelefone     String?                   @map("assinatura_telefone")
  metodoAssinatura       MetodoAssinatura?         @map("metodo_assinatura")
  biometriaSolicitacaoId Int?                      @map("biometria_solicitacao_id")
  codigoVerificacao      String?                   @unique @map("codigo_verificacao")
  empresaCertificadoId       Int?                      @map("empresa_certificado_id")
  empresaAssinouEm           DateTime?                 @map("empresa_assinou_em")
  empresaCertSubject         String?                   @map("empresa_cert_subject")
  empresaCertIssuer          String?                   @map("empresa_cert_issuer")
  empresaCertSerial          String?                   @map("empresa_cert_serial")
  empresaPdfHash                 String?                   @map("empresa_pdf_hash")
  empresaPdfFinal                Bytes?                    @map("empresa_pdf_final")
  empresaPdfFinalStoragePath     String?                   @map("empresa_pdf_final_storage_path")
  empresaRepresentanteNome   String?                   @map("empresa_representante_nome")
  empresaRepresentanteCpf    String?                   @map("empresa_representante_cpf")
  empresaRepresentanteCargo  String?                   @map("empresa_representante_cargo")
  empresaRepresentanteEmail  String?                   @map("empresa_representante_email")
  empresaIp                  String?                   @map("empresa_ip")
  empresaUserAgent           String?                   @map("empresa_user_agent")
  createdAt              DateTime                  @default(now()) @map("created_at")
  updatedAt              DateTime                  @updatedAt @map("updated_at")

  envelope             EnvelopeAssinatura    @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  biometriaSolicitacao BiometriaSolicitacao? @relation(fields: [biometriaSolicitacaoId], references: [id], onDelete: SetNull)
  empresaCertificado   EmpresaCertificadoA1? @relation(fields: [empresaCertificadoId], references: [id], onDelete: SetNull)

  @@unique([envelopeId, codigo])
  @@index([status])
  @@index([biometriaSolicitacaoId])
  @@map("documento_assinatura")
}

model BiometriaDispositivo {
  id           Int       @id @default(autoincrement())
  nome         String
  tokenHash    String    @unique @map("token_hash")
  ativo        Boolean   @default(true)
  ultimoPingEm DateTime? @map("ultimo_ping_em")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  solicitacoes BiometriaSolicitacao[]

  @@map("biometria_dispositivo")
}

model BiometriaTemplate {
  id          Int       @id @default(autoincrement())
  candidatoId Int       @map("candidato_id")
  template    Bytes     @db.ByteA
  criadoEm   DateTime  @default(now()) @map("criado_em")

  candidato   Candidato @relation(fields: [candidatoId], references: [id], onDelete: Cascade)

  @@index([candidatoId])
  @@map("biometria_template")
}

model BiometriaSolicitacao {
  id                   Int                            @id @default(autoincrement())
  tipo                 TipoBiometriaSolicitacao
  status               StatusBiometriaSolicitacao     @default(PENDENTE)
  candidatoId          Int                            @map("candidato_id")
  candidaturaId        Int?                           @map("candidatura_id")
  envelopeId           Int?                           @map("envelope_id")
  solicitadaPorId      Int                            @map("solicitada_por_id")
  dispositivoId        Int?                           @map("dispositivo_id")
  expiraEm             DateTime                       @map("expira_em")
  assumidaEm           DateTime?                      @map("assumida_em")
  concluidaEm          DateTime?                      @map("concluida_em")
  resultado            ResultadoBiometriaSolicitacao?
  cpfRetornado         String?                        @map("cpf_retornado")
  score                Int?
  identificadorExterno String?                        @map("identificador_externo")
  mensagem             String?
  ipResultado          String?                        @map("ip_resultado")
  userAgentResultado   String?                        @map("user_agent_resultado")
  payloadHash          String?                        @map("payload_hash")
  createdAt            DateTime                       @default(now()) @map("created_at")
  updatedAt            DateTime                       @updatedAt @map("updated_at")

  candidato           Candidato             @relation(fields: [candidatoId], references: [id], onDelete: Cascade)
  candidatura         Candidatura?          @relation(fields: [candidaturaId], references: [id], onDelete: Cascade)
  envelope            EnvelopeAssinatura?   @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  solicitadaPor       User                  @relation("BiometriaSolicitadaPor", fields: [solicitadaPorId], references: [id], onDelete: Restrict)
  dispositivo         BiometriaDispositivo? @relation(fields: [dispositivoId], references: [id], onDelete: SetNull)
  documentosAssinados DocumentoAssinatura[]

  @@index([status, expiraEm])
  @@index([candidatoId])
  @@index([envelopeId])
  @@index([dispositivoId])
  @@map("biometria_solicitacao")
}

model EventoAssinatura {
  id          Int                  @id @default(autoincrement())
  envelopeId  Int                  @map("envelope_id")
  documentoId Int?                 @map("documento_id")
  tipo        TipoEventoAssinatura
  ip          String?
  userAgent   String?              @map("user_agent")
  metadata    Json?
  createdAt   DateTime             @default(now()) @map("created_at")

  envelope EnvelopeAssinatura @relation(fields: [envelopeId], references: [id], onDelete: Cascade)

  @@index([envelopeId, createdAt])
  @@map("evento_assinatura")
}

enum StatusDocumentoAdmissao {
  PENDENTE
  ENVIADO
  EM_ANALISE
  APROVADO
  RECUSADO
  REENVIO_SOLICITADO
}

enum OrigemDocumentoAdmissao {
  CANDIDATO
  RH
}

enum ModoSubstituicaoDocumento {
  SEMPRE
  CAMPO_OCR
}

enum ResultadoValidacaoOcr {
  VALIDO
  SUSPEITO
  INVALIDO
}

model DocumentoTemplate {
  id                   Int      @id @default(autoincrement())
  empresaId            Int      @map("empresa_id")
  codigo               String
  nome                 String
  descricao            String?
  palavrasChave        String[] @default([]) @map("palavras_chave")
  mimeTypesPermitidos  String[] @default([]) @map("mime_types_permitidos")
  condicaoGenero       String?  @map("condicao_genero")
  condicaoPossuiFilhos Boolean? @map("condicao_possui_filhos")
  obrigatorio          Boolean  @default(true)
  ordem                Int      @default(0)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  empresa        Empresa                         @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  documentos     DocumentoAdmissao[]
  substitui      DocumentoTemplateSubstituicao[] @relation("TemplateSubstitui")
  substituidoPor DocumentoTemplateSubstituicao[] @relation("TemplateSubstituidoPor")

  @@unique([empresaId, codigo])
  @@index([empresaId, ordem])
  @@map("documento_template")
}

model DocumentoTemplateSubstituicao {
  id                    Int                       @id @default(autoincrement())
  templateId            Int                       @map("template_id")
  substituidoTemplateId Int                       @map("substituido_template_id")
  modo                  ModoSubstituicaoDocumento @default(SEMPRE)
  campoOcr              String?                   @map("campo_ocr")
  createdAt             DateTime                  @default(now()) @map("created_at")

  template    DocumentoTemplate @relation("TemplateSubstitui", fields: [templateId], references: [id], onDelete: Cascade)
  substituido DocumentoTemplate @relation("TemplateSubstituidoPor", fields: [substituidoTemplateId], references: [id], onDelete: Cascade)

  @@unique([templateId, substituidoTemplateId])
  @@index([substituidoTemplateId])
  @@map("documento_template_substituicao")
}

model DocumentoAdmissao {
  id                  Int                      @id @default(autoincrement())
  candidaturaId       Int                      @map("candidatura_id")
  templateId          Int?                     @map("template_id")
  codigo              String
  nome                String
  descricao           String?
  obrigatorio         Boolean                  @default(true)
  status              StatusDocumentoAdmissao  @default(PENDENTE)
  origem              OrigemDocumentoAdmissao?
  arquivoNome         String?                  @map("arquivo_nome")
  mimeType            String?                  @map("mime_type")
  tamanhoBytes        Int?                     @map("tamanho_bytes")
  storagePath         String?                  @map("storage_path")
  enviadoEm           DateTime?                @map("enviado_em")
  revisadoEm          DateTime?                @map("revisado_em")
  revisadoPorId       Int?                     @map("revisado_por_id")
  observacaoRh        String?                  @map("observacao_rh")
  observacaoCandidato String?                  @map("observacao_candidato")
  ocrTexto            String?                  @map("ocr_texto")
  ocrResultado        ResultadoValidacaoOcr?   @map("ocr_resultado")
  ocrScore            Int?                     @map("ocr_score")
  ocrMotivos          String[]                 @default([]) @map("ocr_motivos")
  ocrCampos           Json?                    @map("ocr_campos")
  ocrValidadoEm       DateTime?                @map("ocr_validado_em")
  dispensadoPorId     Int?                     @map("dispensado_por_id")
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")

  candidatura   Candidatura         @relation(fields: [candidaturaId], references: [id], onDelete: Cascade)
  template      DocumentoTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  revisadoPor   User?               @relation("DocumentoRevisadoPor", fields: [revisadoPorId], references: [id], onDelete: SetNull)
  dispensadoPor DocumentoAdmissao?  @relation("DispensaPor", fields: [dispensadoPorId], references: [id], onDelete: SetNull)
  dispensados   DocumentoAdmissao[] @relation("DispensaPor")

  @@unique([candidaturaId, codigo])
  @@index([status])
  @@index([candidaturaId])
  @@index([dispensadoPorId])
  @@map("documento_admissao")
}
