generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CANDIDATO
  RH
  ADMIN
}

model User {
  id        Int        @id @default(autoincrement())
  cpf       String?    @unique
  nome      String?
  email     String?    @unique
  telefone  String?    @unique
  role      Role       @default(CANDIDATO)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  candidato Candidato?

  requisicoesCriadas   RequisicaoVaga[] @relation("RequisicaoCriadaPor")
  requisicoesAprovadas RequisicaoVaga[] @relation("RequisicaoAprovadaPor")

  @@map("users")
}

model Candidato {
  id             Int      @id @default(autoincrement())
  userId         Int?     @unique
  cpf            String   @unique
  dataNascimento DateTime @db.Date
  nome           String?
  email          String?
  telefone       String?
  user       User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  requisicoes RequisicaoVaga[]

  @@map("candidato")
}

model CodeOtp {
  id         String   @id @default(cuid())
  identifier String
  code       String
  expiresAt  DateTime
  used       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([identifier])
  @@map("codeotp")
}

enum StatusRequisicaoVaga {
  RASCUNHO
  ABERTA
  AGUARDANDO_CANDIDATO
  EM_ADMISSAO
  AGUARDANDO_DOCUMENTOS
  AGUARDANDO_ASSINATURA
  AGUARDANDO_RH
  PENDENTE_CORRECAO
  APROVADA
  INTEGRANDO_SENIOR
  INTEGRADA_SENIOR
  CANCELADA
  REPROVADA
  ERRO_INTEGRACAO
}

enum TipoRequisicaoVaga {
  NOVA_VAGA
  SUBSTITUICAO
  AUMENTO_QUADRO
  TEMPORARIA
  OUTRO
}

model RequisicaoVaga {
  id Int @id @default(autoincrement())

  candidatoId Int?
  candidato   Candidato? @relation(fields: [candidatoId], references: [id], onDelete: SetNull)

  criadoPorUserId Int?
  criadoPor       User? @relation("RequisicaoCriadaPor", fields: [criadoPorUserId], references: [id], onDelete: SetNull)

  aprovadoPorUserId Int?
  aprovadoPor       User? @relation("RequisicaoAprovadaPor", fields: [aprovadoPorUserId], references: [id], onDelete: SetNull)

  tipo   TipoRequisicaoVaga   @default(NOVA_VAGA)
  status StatusRequisicaoVaga @default(RASCUNHO)

  empresa     Int?
  filial      Int?
  cargo       String?
  centroCusto String?
  escala      String?
  sindicato   String?

  dataPrevistaAdmissao DateTime? @db.Date

  motivoAbertura String?
  observacao     String?

  codigoRequisicaoSenior String?
  codigoCandidatoSenior  String?
  codigoColaboradorSenior String?

  aprovadoEm          DateTime?
  integradoSeniorEm   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([candidatoId])
  @@index([status])
  @@index([empresa, filial])
  @@map("requisicao_vaga")
}