# URL da API (sem barra final). Em produção, a URL pública da API.
API_BASE_URL=http://localhost:5011

# API Senior usada para descobrir os iDFaces. O agente consulta sempre modrlg=17.
SENIOR_API_URL=http://localhost:3001
IDFACE_MODRLG=17

# Credenciais compartilhadas para acessar os iDFaces descobertos.
IDFACE_LOGIN=admin
IDFACE_PASSWORD=admin

# Confiança mínima (0-1000) do iDFace para aprovar uma verificação
IDFACE_MIN_CONFIDENCE=500

# Se true, uma identificação de pessoa diferente durante a solicitação reprova na hora;
# se false, identificações de outras pessoas são ignoradas até o candidato correto se apresentar
REJECT_ON_MISMATCH=true

# Intervalos de polling (ms)
SOLICITACOES_POLL_INTERVAL_MS=5000
VERIFICACAO_POLL_INTERVAL_MS=1500
HTTP_TIMEOUT_MS=10000

# Nível de log: debug | info | warn | error
LOG_LEVEL=info
