AWS_S3_REGION=us-east-1
AWS_S3_ACCESS_KEY_ID=sua-access-key
AWS_S3_SECRET_ACCESS_KEY=sua-secret-key

# Google Cloud Vision OCR — usado para validar documentos no upload
# Use JSON de uma service account com permissão Cloud Vision API.
GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account","project_id":"seu-projeto","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"ocr@seu-projeto.iam.gserviceaccount.com"}
