# ── base: node + pnpm ──────────────────────────────────────────────────────────
FROM node:22-alpine AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@latest --activate

# ── deps: instala dependências aproveitando cache de camadas ───────────────────
FROM base AS deps
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY apps/web/package.json ./apps/web/
COPY packages/eslint-config/package.json ./packages/eslint-config/
COPY packages/typescript-config/package.json ./packages/typescript-config/
COPY packages/ui/package.json ./packages/ui/

RUN pnpm install --frozen-lockfile

# ── dev: hot reload para desenvolvimento ──────────────────────────────────────
FROM base AS dev
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/web/node_modules ./apps/web/node_modules

# Copia source completo dos packages compartilhados (tsconfig, eslint, ui)
COPY packages ./packages
COPY apps/web ./apps/web
COPY package.json pnpm-workspace.yaml turbo.json ./

EXPOSE 5010
CMD ["pnpm", "--filter", "web", "dev"]

# ── build: compila os assets estáticos ────────────────────────────────────────
FROM deps AS build
WORKDIR /app

# VITE_* precisam estar disponíveis em build time
ARG VITE_API_URL
ARG VITE_SENIOR_API_URL
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_SENIOR_API_URL=$VITE_SENIOR_API_URL

COPY . .
RUN pnpm --filter web build

# ── production: Nginx servindo os assets ──────────────────────────────────────
FROM nginx:alpine AS production

COPY --from=build /app/apps/web/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
