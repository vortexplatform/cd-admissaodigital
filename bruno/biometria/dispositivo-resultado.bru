meta {
  name: Registrar resultado biométrico
  type: http
  seq: 7
}

post {
  url: {{base_url}}/biometria/dispositivo/solicitacoes/1/resultado
  body: json
  auth: none
}

headers {
  x-device-token: SEU_DEVICE_TOKEN_AQUI
}

body:json {
  {
    "resultado": "APROVADO",
    "cpfRetornado": "12345678901",
    "score": 95,
    "identificadorExterno": "ext-id-001",
    "mensagem": "Biometria verificada com sucesso"
  }
}
